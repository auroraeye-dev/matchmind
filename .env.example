# Copy to .env (never commit .env). Leave everything blank to run fully offline.
# LLM_PROVIDER: auto | azure | openai | github | offline
LLM_PROVIDER=auto

# --- Azure OpenAI / Microsoft Foundry model deployment ---
AZURE_OPENAI_ENDPOINT=            # e.g. https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Any OpenAI-compatible endpoint (e.g. Foundry project .../openai/v1/) ---
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- GitHub Models (free prototyping) ---
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4o-mini

# --- Tuning ---
LLM_TIMEOUT_S=6
LLM_MAX_CONCURRENCY=4
LLM_MIN_IMPORTANCE=0.5
