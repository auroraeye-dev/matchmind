# Copy to .env (never commit .env). Leave everything blank to run fully offline.
# LLM_PROVIDER: auto | foundry | azure | openai | github | offline
LLM_PROVIDER=auto

# --- Microsoft Foundry project (recommended; keyless: run `az login` locally, managed identity in Azure) ---
FOUNDRY_PROJECT_ENDPOINT=         # https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-4o-mini

# --- Azure OpenAI deployment with a key ---
AZURE_OPENAI_ENDPOINT=            # https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Any OpenAI-compatible endpoint ---
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- GitHub Models (free prototyping) ---
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4o-mini

# --- Azure AI Translator (optional) ---
TRANSLATOR_KEY=
TRANSLATOR_REGION=

# --- Azure Cosmos DB (optional; key optional, Entra ID used otherwise) ---
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=matchmind
COSMOS_CONTAINER=match_items

# --- Microsoft Fabric Eventstream custom endpoint (optional) ---
FABRIC_EVENTSTREAM_CONNECTION_STRING=
FABRIC_EVENTSTREAM_NAME=

# --- MCP over HTTP: comma-separated allowed Host headers (enables DNS-rebinding protection) ---
MCP_ALLOWED_HOSTS=

# --- Tuning ---
LLM_TIMEOUT_S=6
LLM_MAX_CONCURRENCY=4
LLM_MIN_IMPORTANCE=0.5
